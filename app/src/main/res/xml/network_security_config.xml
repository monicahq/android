<?xml version="1.0" encoding="utf-8"?>
<!-- Release builds talk to instances over HTTPS only, trusting the system's certificate
     authorities. The debug build overrides this file to reach a Monica on the developer's machine. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
