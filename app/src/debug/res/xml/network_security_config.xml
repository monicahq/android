<?xml version="1.0" encoding="utf-8"?>
<!-- Debug builds only: plain http and user-installed certificate authorities, to run the app
     against a Monica on the developer's machine. Never part of a release build. -->
<network-security-config xmlns:tools="http://schemas.android.com/tools"
    tools:ignore="AcceptsUserCertificates,InsecureBaseConfiguration">
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" />
        </trust-anchors>
    </base-config>
</network-security-config>
